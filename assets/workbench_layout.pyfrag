                    with gr.Group(elem_id="wb-history-card", elem_classes=["wb-panel", "wb-history-panel"]):
                        gr.HTML(
                            "<div class='wb-section-head'><div class='wb-section-label'>\u751f\u6210\u8bb0\u5f55</div>"
                            "<span class='wb-section-extra'>HISTORY / MP4</span></div>"
                            "<div class='wb-panel-help'>\u67e5\u770b\u3001\u64ad\u653e\u548c\u4e0b\u8f7d\u5df2\u4fdd\u5b58\u7684\u539f\u59cb\u89c6\u9891\uff1b\u65e7\u6587\u4ef6\u4f1a\u81ea\u52a8\u7d22\u5f15\u3002</div>",
                            elem_classes=["wb-html"],
                        )
                        history_page_state = gr.State(0)
                        with gr.Row(elem_classes=["wb-history-toolbar"]):
                            history_search = gr.Textbox(
                                label="\u641c\u7d22\u6587\u4ef6\u540d\u6216\u63d0\u793a\u8bcd", placeholder="MP4 / Prompt",
                                elem_id="wb-history-search", scale=3,
                            )
                            history_search_btn = gr.Button("\u641c\u7d22", scale=1, variant="secondary")
                            history_refresh_btn = gr.Button("\u5237\u65b0\u8bb0\u5f55", scale=1)
                        history_table = gr.Dataframe(
                            headers=["\u751f\u6210\u65f6\u95f4", "\u6587\u4ef6", "\u72b6\u6001", "\u5927\u5c0f", "\u6765\u6e90", "\u63d0\u793a\u8bcd"],
                            datatype=["str"] * 6, interactive=False, wrap=True,
                            elem_id="wb-history-table",
                        )
                        with gr.Row(elem_classes=["wb-history-pager"]):
                            history_prev_btn = gr.Button("\u4e0a\u4e00\u9875", size="sm")
                            history_page_text = gr.Textbox(value="", show_label=False, interactive=False, scale=3)
                            history_next_btn = gr.Button("\u4e0b\u4e00\u9875", size="sm")
                        history_selector = gr.Dropdown(
                            label="\u9009\u62e9\u8981\u67e5\u770b\u7684\u8bb0\u5f55", choices=[], value=None,
                            elem_id="wb-history-select",
                        )
                        with gr.Row(elem_classes=["wb-history-media"]):
                            history_video = gr.Video(
                                label="\u5386\u53f2\u89c6\u9891\u9884\u89c8", include_audio=True,
                                height=240, elem_id="wb-history-video",
                            )
                            history_download = gr.File(
                                label="\u4e0b\u8f7d\u539f\u59cb MP4", elem_id="wb-history-download",
                            )
                        history_detail = gr.Textbox(
                            label="\u4efb\u52a1\u8be6\u60c5", interactive=False,
                            lines=4, max_lines=8,
                        )
            gr.HTML(
                '''<div class="wb-footer"><span>© 内蒙古民族幼儿师范视频模型 · 视频创作工作台</span><span><strong>Powered by MiniMax H3</strong> &nbsp; / &nbsp; UI WORKBENCH</span></div>''',
                elem_classes=["wb-html"],
            )

        # Preserve the existing Ref2VA selection and the same callback contract.
        upload_reference_image.change(
            fn=lambda enabled: gr.update(visible=bool(enabled), value=None),
            inputs=upload_reference_image,
            outputs=reference_image,
        )
        history_outputs = [history_table, history_selector, history_page_text,
                           history_page_state, history_video, history_download, history_detail]
        demo.load(fn=lambda: history_refresh(0, ""), outputs=history_outputs)
        history_refresh_btn.click(
            fn=lambda page, query: history_refresh(page, query),
            inputs=[history_page_state, history_search], outputs=history_outputs,
        )
        history_search_btn.click(
            fn=lambda query: history_refresh(0, query),
            inputs=history_search, outputs=history_outputs,
        )
        history_prev_btn.click(
            fn=lambda page, query: history_refresh(page, query, -1),
            inputs=[history_page_state, history_search], outputs=history_outputs,
        )
        history_next_btn.click(
            fn=lambda page, query: history_refresh(page, query, 1),
            inputs=[history_page_state, history_search], outputs=history_outputs,
        )
        history_selector.change(
            fn=history_select, inputs=history_selector,
            outputs=[history_video, history_download, history_detail],
        )
        generate_event = run_btn.click(
            fn=generate_with_history,
            inputs=[
                prompt,
                task,
                first_frame,
                last_frame,
                reference_image,
                reference_video,
                reference_audio,
                upload_reference_image,
                seed,
                num_inference_steps,
                short_edge,
                aspect_ratio,
                duration_seconds,
                flow_shift,
                audio_flow_shift,
            ],
            outputs=video_out,
        )
        generate_event.success(
            fn=lambda page, query: history_refresh(page, query),
            inputs=[history_page_state, history_search], outputs=history_outputs,
        )

        _, local_url, _ = demo.launch(
            server_port=server_args.webui_port,
            quiet=True,
            prevent_thread_lock=True,
            show_error=True,
            allowed_paths=[str(history.output_dir)],
            **(style_kwargs if style_in_launch else {}),
        )
        url = local_url or f"http://localhost:{server_args.webui_port}"
        print(f"SGLang MiniMax H3 WebUI available at: {url}")
        demo.block_thread()
